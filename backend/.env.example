# ─── Troy's Footy IQ — Environment Configuration ────────────────────
# Copy this file to .env and fill in your actual values.

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — At least one API key must be set for live data
# ═══════════════════════════════════════════════════════════════════

# API-Football (api-football.com) — Primary data source
APISPORTS_KEY=your_apisports_key_here

# Football-Data.org — Secondary/fallback data source
FOOTBALLDATA_TOKEN=your_footballdata_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/football

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Enhanced features
# ═══════════════════════════════════════════════════════════════════

# Anthropic Claude API key — enables AI analysis and model insights
ANTHROPIC_API_KEY=your_anthropic_key_here

# Server port (default: 3001)
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# Frontend URL for CORS (used in production)
FRONTEND_URL=https://your-frontend.vercel.app

# ═══════════════════════════════════════════════════════════════════
# DATA SOURCES — No keys required
# ═══════════════════════════════════════════════════════════════════
# ClubElo (services/clubelo.js) — production-safe, no auth, free for any use
# Open-Meteo (services/sources/openMeteo.js) — RESEARCH-ONLY, no auth
# StatsBomb Open Data (scripts/ingestStatsBombOpen.js) — RESEARCH-ONLY, no auth
# See services/sources/README.md for the commercial-use tripwire.

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Weather (commercial-safe alternative to Open-Meteo)
# ═══════════════════════════════════════════════════════════════════
# OpenWeather free tier — 1,000 calls/day, commercial use permitted
# Sign up at https://openweathermap.org/api → copy key here
OPENWEATHER_API_KEY=
