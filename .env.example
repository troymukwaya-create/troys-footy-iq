# football-data.org (free — sign up at football-data.org/client/register)
FOOTBALLDATA_TOKEN=your_token_here

# API-Football via RapidAPI (free — sign up at rapidapi.com, subscribe to API-Football free plan)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# Claude API (user already has this)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/football

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
